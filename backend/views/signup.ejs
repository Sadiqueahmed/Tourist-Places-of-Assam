<section class="auth-section" style="padding: 150px 9% 50px; min-height: 100vh; background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url(/assets/Images/image34.jpg) center/cover no-repeat; display: flex; align-items: center; justify-content: center;">
    <div class="auth-container" style="background: white; padding: 40px; border-radius: 15px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); width: 100%; max-width: 450px;">
        <h2 style="text-align: center; color: #10221b; font-size: 2.5rem; margin-bottom: 30px; font-family: 'Bebas Neue', cursive;">Create Account</h2>
        
        <form action="/auth/register" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
            <div class="form-group">
                <label for="name" style="display: block; margin-bottom: 8px; color: #10221b; font-size: 1.4rem; font-weight: 500;">Full Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required 
                    placeholder="Enter your full name"
                    style="width: 100%; padding: 12px 15px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1.4rem; transition: border-color 0.3s;"
                    onfocus="this.style.borderColor='#219150'"
                    onblur="this.style.borderColor='#e0e0e0'"
                >
            </div>
            
            <div class="form-group">
                <label for="email" style="display: block; margin-bottom: 8px; color: #10221b; font-size: 1.4rem; font-weight: 500;">Email Address</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="Enter your email"
                    style="width: 100%; padding: 12px 15px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1.4rem; transition: border-color 0.3s;"
                    onfocus="this.style.borderColor='#219150'"
                    onblur="this.style.borderColor='#e0e0e0'"
                >
            </div>
            
            <div class="form-group">
                <label for="password" style="display: block; margin-bottom: 8px; color: #10221b; font-size: 1.4rem; font-weight: 500;">Password</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    required 
                    minlength="6"
                    placeholder="Create a password (min 6 characters)"
                    style="width: 100%; padding: 12px 15px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1.4rem; transition: border-color 0.3s;"
                    onfocus="this.style.borderColor='#219150'"
                    onblur="this.style.borderColor='#e0e0e0'"
                >
            </div>
            
            <div class="form-group">
                <label for="confirmPassword" style="display: block; margin-bottom: 8px; color: #10221b; font-size: 1.4rem; font-weight: 500;">Confirm Password</label>
                <input 
                    type="password" 
                    id="confirmPassword" 
                    name="confirmPassword" 
                    required 
                    placeholder="Confirm your password"
                    style="width: 100%; padding: 12px 15px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1.4rem; transition: border-color 0.3s;"
                    onfocus="this.style.borderColor='#219150'"
                    onblur="this.style.borderColor='#e0e0e0'"
                >
            </div>
            
            <div class="form-options" style="display: flex; align-items: center; font-size: 1.2rem;">
                <label style="display: flex; align-items: center; gap: 5px; cursor: pointer; color: #666;">
                    <input type="checkbox" name="terms" required style="cursor: pointer;">
                    I agree to the <a href="#" style="color: #219150;">Terms of Service</a> and <a href="#" style="color: #219150;">Privacy Policy</a>
                </label>
            </div>
            
            <button 
                type="submit" 
                class="btn"
                style="margin-top: 10px; width: 100%; padding: 14px; background: #219150; color: white; border: none; border-radius: 8px; font-size: 1.6rem; cursor: pointer; transition: all 0.3s;"
                onmouseover="this.style.background='#1a7a3e'"
                onmouseout="this.style.background='#219150'"
            >
                Create Account
            </button>
        </form>
        
        <div class="auth-footer" style="text-align: center; margin-top: 25px; padding-top: 20px; border-top: 1px solid #e0e0e0;">
            <p style="color: #666; font-size: 1.4rem;">
                Already have an account? 
                <a href="/auth/login" style="color: #219150; text-decoration: none; font-weight: 600;">Log in</a>
            </p>
        </div>
        
        <div class="social-login" style="margin-top: 25px;">
            <p style="text-align: center; color: #666; font-size: 1.3rem; margin-bottom: 15px;">Or sign up with</p>
            <div style="display: flex; gap: 15px; justify-content: center;">
                <a href="#" style="width: 45px; height: 45px; border-radius: 50%; background: #f5f5f5; display: flex; align-items: center; justify-content: center; color: #db4437; font-size: 1.8rem; transition: all 0.3s;" onmouseover="this.style.background='#db4437'; this.style.color='white'" onmouseout="this.style.background='#f5f5f5'; this.style.color='#db4437'">
                    <i class="fab fa-google"></i>
                </a>
                <a href="#" style="width: 45px; height: 45px; border-radius: 50%; background: #f5f5f5; display: flex; align-items: center; justify-content: center; color: #4267B2; font-size: 1.8rem; transition: all 0.3s;" onmouseover="this.style.background='#4267B2'; this.style.color='white'" onmouseout="this.style.background='#f5f5f5'; this.style.color='#4267B2'">
                    <i class="fab fa-facebook-f"></i>
                </a>
            </div>
        </div>
    </div>
</section>

