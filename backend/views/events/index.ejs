<!-- events section starts -->
<section class="events" style="padding-top: 100px; min-height: 100vh;">
    <div class="events-header" style="text-align: center; padding: 50px 9%;">
        <h1 class="heading" style="font-size: 4rem; color: #10221b; margin-bottom: 20px;">Events & Festivals</h1>
        <p style="font-size: 1.6rem; color: #666; max-width: 800px; margin: 0 auto;">
            Experience the vibrant culture of Assam through its colorful festivals and traditional celebrations throughout the year.
        </p>
    </div>

    <!-- Events Grid -->
    <div class="events-grid" style="padding: 0 9% 50px; display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px;">
        <% if (events && events.length > 0) { %>
            <% events.forEach(event => { %>
                <div class="event-card" style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.1); transition: transform 0.3s;"
                     onmouseover="this.style.transform='translateY(-10px)'"
                     onmouseout="this.style.transform='translateY(0)'">
                    <div class="event-image" style="height: 250px; overflow: hidden; position: relative;">
                        <img src="<%= event.image_url || '/assets/Images/placeholder.jpg' %>" 
                             alt="<%= event.title %>"
                             style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;"
                             onmouseover="this.style.transform='scale(1.1)'"
                             onmouseout="this.style.transform='scale(1)'">
                        <div class="event-date" style="position: absolute; top: 20px; left: 20px; background: #219150; color: white; padding: 15px 20px; border-radius: 10px; text-align: center;">
                            <% const eventDate = new Date(event.date); %>
                            <div style="font-size: 2.5rem; font-weight: bold; line-height: 1;"><%= eventDate.getDate() %></div>
                            <div style="font-size: 1.4rem; text-transform: uppercase;"><%= eventDate.toLocaleString('default', { month: 'short' }) %></div>
                        </div>
                    </div>
                    <div class="event-content" style="padding: 30px;">
                        <h3 style="font-size: 2.2rem; color: #10221b; margin-bottom: 15px;"><%= event.title %></h3>
                        <p style="color: #666; font-size: 1.4rem; line-height: 1.6; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            <%= event.description || 'No description available' %>
                        </p>
                        <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 20px;">
                            <span style="display: flex; align-items: center; gap: 8px; color: #666; font-size: 1.3rem;">
                                <i class="fas fa-map-marker-alt" style="color: #219150;"></i>
                                <%= event.location || 'Assam' %>
                            </span>
                            <% if (event.organizer) { %>
                                <span style="display: flex; align-items: center; gap: 8px; color: #666; font-size: 1.3rem;">
                                    <i class="fas fa-users" style="color: #219150;"></i>
                                    <%= event.organizer %>
                                </span>
                            <% } %>
                        </div>
                        <a href="/events/<%= event.id %>" 
                           style="display: inline-block; padding: 12px 30px; background: #219150; color: white; text-decoration: none; border-radius: 25px; font-size: 1.4rem; transition: all 0.3s;"
                           onmouseover="this.style.background='#1a7a3e'"
                           onmouseout="this.style.background='#219150'">
                            Learn More <i class="fas fa-arrow-right" style="margin-left: 8px;"></i>
                        </a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <!-- Fallback static events -->
            <div class="event-card" style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.1);">
                <div class="event-image" style="height: 250px; overflow: hidden; position: relative;">
                    <img src="/assets/Images/bihu.jpg" alt="Bihu Festival" style="width: 100%; height: 100%; object-fit: cover;">
                    <div class="event-date" style="position: absolute; top: 20px; left: 20px; background: #219150; color: white; padding: 15px 20px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 2.5rem; font-weight: bold; line-height: 1;">14</div>
                        <div style="font-size: 1.4rem; text-transform: uppercase;">APR</div>
                    </div>
                </div>
                <div class="event-content" style="padding: 30px;">
                    <h3 style="font-size: 2.2rem; color: #10221b; margin-bottom: 15px;">Bihu Festival</h3>
                    <p style="color: #666; font-size: 1.4rem; line-height: 1.6; margin-bottom: 20px;">
                        Bihu is the essence of Assam and is celebrated across the state with tremendous zeal and enthusiasm. It marks the Assamese New Year and the arrival of spring.
                    </p>
                    <a href="#" style="display: inline-block; padding: 12px 30px; background: #219150; color: white; text-decoration: none; border-radius: 25px; font-size: 1.4rem;">
                        Learn More <i class="fas fa-arrow-right" style="margin-left: 8px;"></i>
                    </a>
                </div>
            </div>

            <div class="event-card" style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.1);">
                <div class="event-image" style="height: 250px; overflow: hidden; position: relative;">
                    <img src="/assets/Images/Me-Dum-Me-Phi.jpg" alt="Me-Dum-Me-Phi" style="width: 100%; height: 100%; object-fit: cover;">
                    <div class="event-date" style="position: absolute; top: 20px; left: 20px; background: #ff9800; color: white; padding: 15px 20px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 2.5rem; font-weight: bold; line-height: 1;">31</div>
                        <div style="font-size: 1.4rem; text-transform: uppercase;">JAN</div>
                    </div>
                </div>
                <div class="event-content" style="padding: 30px;">
                    <h3 style="font-size: 2.2rem; color: #10221b; margin-bottom: 15px;">Me-Dum-Me-Phi</h3>
                    <p style="color: #666; font-size: 1.4rem; line-height: 1.6; margin-bottom: 20px;">
                        Literally in Me-Dum-Me-Phi, 'Me' means worship, 'Dum' means the dead and 'Phi' means God. It is an ancestor worship festival celebrated by the Ahom community.
                    </p>
                    <a href="#" style="display: inline-block; padding: 12px 30px; background: #219150; color: white; text-decoration: none; border-radius: 25px; font-size: 1.4rem;">
                        Learn More <i class="fas fa-arrow-right" style="margin-left: 8px;"></i>
                    </a>
                </div>
            </div>

            <div class="event-card" style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.1);">
                <div class="event-image" style="height: 250px; overflow: hidden; position: relative;">
                    <img src="/assets/Images/Dehing Patkai Festival.jpg" alt="Dehing Patkai Festival" style="width: 100%; height: 100%; object-fit: cover;">
                    <div class="event-date" style="position: absolute; top: 20px; left: 20px; background: #2196f3; color: white; padding: 15px 20px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 2.5rem; font-weight: bold; line-height: 1;">15</div>
                        <div style="font-size: 1.4rem; text-transform: uppercase;">FEB</div>
                    </div>
                </div>
                <div class="event-content" style="padding: 30px;">
                    <h3 style="font-size: 2.2rem; color: #10221b; margin-bottom: 15px;">Dehing Patkai Festival</h3>
                    <p style="color: #666; font-size: 1.4rem; line-height: 1.6; margin-bottom: 20px;">
                        The Dehing Patkai Festival organized at Lekhapani, in the Tinsukia district of Assam, is a vibrant celebration of the region's rich cultural heritage.
                    </p>
                    <a href="#" style="display: inline-block; padding: 12px 30px; background: #219150; color: white; text-decoration: none; border-radius: 25px; font-size: 1.4rem;">
                        Learn More <i class="fas fa-arrow-right" style="margin-left: 8px;"></i>
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</section>
<!-- events section ends -->

