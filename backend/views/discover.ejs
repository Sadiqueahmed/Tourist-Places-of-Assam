<!-- discover section starts -->
<section class="discover" style="padding-top: 100px; min-height: 100vh;">
    <div class="discover-header" style="text-align: center; padding: 50px 9%;">
        <h1 class="heading" style="font-size: 4rem; color: #10221b; margin-bottom: 20px;">Discover Assam</h1>
        <p style="font-size: 1.6rem; color: #666; max-width: 800px; margin: 0 auto;">
            Explore the breathtaking destinations of Assam, from wildlife sanctuaries to ancient temples and serene hill stations.
        </p>
    </div>

    <!-- Filter Section -->
    <div class="filter-section" style="padding: 0 9% 30px;">
        <div style="display: flex; gap: 15px; flex-wrap: wrap; justify-content: center;">
            <a href="/discover" class="filter-btn <%= !selectedCategory ? 'active' : '' %>" 
               style="padding: 10px 25px; border-radius: 25px; text-decoration: none; font-size: 1.4rem; transition: all 0.3s;
                      <%= !selectedCategory ? 'background: #219150; color: white;' : 'background: #f0f0f0; color: #10221b;' %>">
                All
            </a>
            <a href="/discover?category=wildlife" class="filter-btn <%= selectedCategory === 'wildlife' ? 'active' : '' %>"
               style="padding: 10px 25px; border-radius: 25px; text-decoration: none; font-size: 1.4rem; transition: all 0.3s;
                      <%= selectedCategory === 'wildlife' ? 'background: #219150; color: white;' : 'background: #f0f0f0; color: #10221b;' %>">
                Wildlife Sanctuaries
            </a>
            <a href="/discover?category=hill-stations" class="filter-btn <%= selectedCategory === 'hill-stations' ? 'active' : '' %>"
               style="padding: 10px 25px; border-radius: 25px; text-decoration: none; font-size: 1.4rem; transition: all 0.3s;
                      <%= selectedCategory === 'hill-stations' ? 'background: #219150; color: white;' : 'background: #f0f0f0; color: #10221b;' %>">
                Hill Stations
            </a>
            <a href="/discover?category=holy-places" class="filter-btn <%= selectedCategory === 'holy-places' ? 'active' : '' %>"
               style="padding: 10px 25px; border-radius: 25px; text-decoration: none; font-size: 1.4rem; transition: all 0.3s;
                      <%= selectedCategory === 'holy-places' ? 'background: #219150; color: white;' : 'background: #f0f0f0; color: #10221b;' %>">
                Holy Places
            </a>
        </div>
    </div>

    <!-- Places Grid -->
    <div class="places-grid" style="padding: 0 9% 50px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
        <% if (places && places.length > 0) { %>
            <% places.forEach(place => { %>
                <div class="place-card" style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.1); transition: transform 0.3s;"
                     onmouseover="this.style.transform='translateY(-10px)'"
                     onmouseout="this.style.transform='translateY(0)'">
                    <div class="place-image" style="height: 220px; overflow: hidden;">
                        <img src="<%= place.image_url || '/assets/Images/placeholder.jpg' %>" 
                             alt="<%= place.name %>" 
                             style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;"
                             onmouseover="this.style.transform='scale(1.1)'"
                             onmouseout="this.style.transform='scale(1)'">
                    </div>
                    <div class="place-content" style="padding: 25px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <h3 style="font-size: 2rem; color: #10221b; margin: 0;"><%= place.name %></h3>
                            <div class="rating" style="display: flex; align-items: center; gap: 5px; color: #ffa500;">
                                <i class="fas fa-star"></i>
                                <span style="color: #10221b; font-weight: 600;"><%= place.rating || '4.0' %></span>
                            </div>
                        </div>
                        <p style="color: #666; font-size: 1.4rem; line-height: 1.6; margin-bottom: 15px;">
                            <i class="fas fa-map-marker-alt" style="color: #219150; margin-right: 5px;"></i>
                            <%= place.location || 'Assam' %>
                        </p>
                        <p style="color: #666; font-size: 1.3rem; line-height: 1.6; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            <%= place.description || 'No description available' %>
                        </p>
                        <a href="/places/<%= place.id %>" 
                           style="display: inline-block; padding: 12px 25px; background: #219150; color: white; text-decoration: none; border-radius: 25px; font-size: 1.4rem; transition: all 0.3s;"
                           onmouseover="this.style.background='#1a7a3e'"
                           onmouseout="this.style.background='#219150'">
                            Explore <i class="fas fa-arrow-right" style="margin-left: 5px;"></i>
                        </a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div style="grid-column: 1 / -1; text-align: center; padding: 50px;">
                <i class="fas fa-search" style="font-size: 5rem; color: #ddd; margin-bottom: 20px;"></i>
                <h3 style="color: #666; font-size: 2rem;">No places found</h3>
                <p style="color: #999;">Try adjusting your filters or search criteria</p>
            </div>
        <% } %>
    </div>
</section>
<!-- discover section ends -->

<style>
    .filter-btn:hover {
        background: #219150 !important;
        color: white !important;
    }
</style>

