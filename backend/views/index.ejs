<!-- video section -->
<div class="video-section">
    <iframe width="1110" height="625" src="https://www.youtube.com/embed/BcbpC3rT90s?si=wbZte35iAfkcc_7w" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>

<!-- event home page section starts -->
<section class="event">
    <h1 class="heading1">Events</h1>
    <div class="eventrow">
        <% if (events && events.length > 0) { %>
            <% events.forEach(event => { %>
                <div class="example-2 card">
                    <% const eventBgImage = event.image_url || '/assets/Images/placeholder.jpg'; %>
                    <div class="wrapper" style="background: linear-gradient(#ffffff00, #00000082), url('<%= eventBgImage %>') center/cover no-repeat;">
                        <div class="head">
                            <div class="date">
                                <% const eventDate = new Date(event.date); %>
                                <span class="day"><%= eventDate.getDate() %></span>
                                <span class="month"><%= eventDate.toLocaleString('default', { month: 'short' }) %></span>
                                <span class="year"><%= eventDate.getFullYear() %></span>
                            </div>
                            <ul class="menu-content">
                                <li><a href="#" class="fa fa-bookmark-o"></a></li>
                                <li><a href="#" class="fa fa-heart-o"><span>18</span></a></li>
                                <li><a href="#" class="fa fa-comment-o"><span>3</span></a></li>
                            </ul>
                        </div>
                        <div class="data">
                            <div class="Econtent">
                                <h1 class="title"><a href="/events/<%= event.id %>"><%= event.title %></a></h1>
                                <p class="text1"><%= event.description ? event.description.substring(0, 100) + '...' : 'No description available' %></p>
                                <a href="/events/<%= event.id %>" class="Ebutton">Read more</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <!-- Fallback static events -->
            <div class="example-2 card">
                <div class="wrapper" style="background: linear-gradient(#ffffff00, #00000082), url(/assets/Images/bihu.jpg) center/cover no-repeat;">
                    <div class="head">
                        <div class="date">
                            <span class="day">14</span>
                            <span class="month">Apr</span>
                            <span class="year">2024</span>
                        </div>
                        <ul class="menu-content">
                            <li><a href="#" class="fa fa-bookmark-o"></a></li>
                            <li><a href="#" class="fa fa-heart-o"><span>18</span></a></li>
                            <li><a href="#" class="fa fa-comment-o"><span>3</span></a></li>
                        </ul>
                    </div>
                    <div class="data">
                        <div class="Econtent">
                            <h1 class="title"><a href="#">Bihu Festival</a></h1>
                            <p class="text1">Bihu is the essence of Assam and is celebrated across the state with tremendous zeal...</p>
                            <a href="/events" class="Ebutton">Read more</a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</section>
<!-- event home page section ends -->

<!-- Traditional Products section start -->
<section class="products">
    <h1 class="heading1">Traditional Products</h1>
    <div class="wrapper">
        <div class="item-bg"></div>
        <div class="news-slider">
            <div class="news-slider__wrp swiper-wrapper">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <div class="news-slider__item swiper-slide">
                            <a href="/products/<%= product.id %>" class="news__item">
                                <div class="news__title"><%= product.name %></div>
                                <p class="news__txt"><%= product.description ? product.description.substring(0, 100) + '...' : 'No description available' %></p>
                                <div class="news__img">
                                    <img src="<%= product.image_url || '/assets/Images/placeholder.jpg' %>" alt="<%= product.name %>">
                                </div>
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <!-- Fallback static products -->
                    <div class="news-slider__item swiper-slide">
                        <a href="/products" class="news__item">
                            <div class="news__title">Traditional Mask</div>
                            <p class="news__txt">The art of mask making is Gurujana's one of the most unique creations...</p>
                            <div class="news__img">
                                <img src="/assets/Images/masks/Mukh mukha.jpg" alt="Traditional Mask">
                            </div>
                        </a>
                    </div>
                <% } %>
            </div>
            <div class="news-slider__ctr">
                <div class="news-slider__arrows">
                    <button class="news-slider__arrow news-slider-prev">
                        <span class="icon-font">
                            <svg class="picon icon-arrow-left"><use xlink:href="#icon-arrow-left"></use></svg>
                        </span>
                    </button>
                    <button class="news-slider__arrow news-slider-next">
                        <span class="icon-font">
                            <svg class="picon icon-arrow-right"><use xlink:href="#icon-arrow-right"></use></svg>
                        </span>
                    </button>
                </div>
                <div class="news-slider__pagination"></div>
            </div>
        </div>
    </div>
</section>
<!-- Traditional Products section end -->

<!-- reviews section starts -->
<section class="reviews" id="reviews">
    <h1 class="heading">Tourist's Reviews</h1>
    <div class="swiper review-slider">
        <div class="swiper-wrapper">
            <% if (reviews && reviews.length > 0) { %>
                <% reviews.forEach(review => { %>
                    <div class="swiper-slide slide">
                        <p class="text">"<%= review.comment %>"</p>
                        <div class="user">
                            <img src="/assets/Images/pic-1.png" alt="<%= review.users?.name || 'User' %>">
                            <div class="info">
                                <h3><%= review.users?.name || 'Anonymous' %></h3>
                                <span><%= review.rating %>/5 stars</span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <!-- Fallback static reviews -->
                <div class="swiper-slide slide">
                    <p class="text">"Kaziranga is truly a gem! The safari experience was unforgettable, and spotting the one-horned rhinoceros in their natural habitat was the highlight of our trip."</p>
                    <div class="user">
                        <img src="/assets/Images/pic-1.png" alt="John D.">
                        <div class="info">
                            <h3>John D.</h3>
                            <span>United Kingdom</span>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</section>
<!-- reviews section ends -->

<script>
    function scrollToNextSection() {
        document.getElementById('popular').scrollIntoView({ behavior: 'smooth' });
    }
</script>
