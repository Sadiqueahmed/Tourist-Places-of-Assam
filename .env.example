# MongoDB Connection String (Required)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/visit_assam?retryWrites=true&w=majority"

# Port (Optional, default: 3000)
PORT=3000

# Secret keys for sessions and JWT (Required)
JWT_SECRET="your_jwt_secret_key"
SESSION_SECRET="your_session_secret_key"

# Cloudinary Storage Configuration (Required for image uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
